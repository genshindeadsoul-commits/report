# Copy this file to `.env` in the backend/ directory and fill in real values
# from your Supabase project (Project Settings -> API, and API -> JWT Settings).
# Never commit the real .env file.

# Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings -> API -> service_role secret key
# Server-side only. Never expose this to the frontend or commit it.
SUPABASE_SERVICE_KEY=your-service-role-key

# Project Settings -> API -> JWT Settings -> JWT Secret
# Used to verify Supabase Auth tokens sent by the frontend.
SUPABASE_JWT_SECRET=your-jwt-secret
